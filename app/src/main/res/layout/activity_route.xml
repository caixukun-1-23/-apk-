<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/surfaceBackground" android:orientation="vertical">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar_route" android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize" android:background="@color/surfaceBackground"
        app:navigationIcon="?attr/homeAsUpIndicator" app:navigationIconTint="@color/textPrimary"
        app:title="@string/home_route_library" app:titleTextColor="@color/textPrimary" />
    <androidx.appcompat.widget.SearchView
        android:id="@+id/route_search_view" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginHorizontal="20dp"
        android:minHeight="48dp" android:background="@drawable/bg_cyber_card"
        app:iconifiedByDefault="false" app:queryHint="@string/route_library_search_hint"
        android:theme="@style/AppTheme.PopupOverlay" />
    <TextView android:id="@+id/route_count" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:paddingHorizontal="24dp"
        android:paddingTop="14dp" android:paddingBottom="8dp"
        android:textColor="@color/textSecondary" android:textSize="13sp" />
    <com.google.android.material.progressindicator.LinearProgressIndicator
        android:id="@+id/route_loading" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:indeterminate="true"
        android:visibility="invisible" app:indicatorColor="@color/colorPrimary" />
    <TextView android:id="@+id/route_error" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:padding="20dp"
        android:textColor="@color/saberGold" android:textSize="14sp"
        android:accessibilityLiveRegion="polite" android:visibility="gone" />
    <com.google.android.material.button.MaterialButton
        android:id="@+id/route_retry_button" style="@style/SaberGhostButton"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal" android:text="@string/route_retry" android:visibility="gone" />
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <TextView android:id="@+id/route_no_data" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_gravity="center"
            android:gravity="center" android:padding="28dp" android:lineSpacingExtra="8dp"
            android:textColor="@color/textSecondary" android:textSize="15sp" android:visibility="gone" />
        <ListView android:id="@+id/route_list_view" android:layout_width="match_parent"
            android:layout_height="match_parent" android:clipToPadding="false"
            android:divider="@android:color/transparent" android:dividerHeight="12dp"
            android:padding="20dp" />
    </FrameLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingHorizontal="20dp" android:paddingVertical="8dp"
        android:background="@color/surfaceBackground" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton
            android:id="@+id/fab_import" style="@style/SaberGhostButton"
            android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginEnd="6dp" android:text="@string/route_import_button" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/route_create_button" android:layout_width="0dp"
            android:layout_height="wrap_content" android:layout_weight="1"
            android:layout_marginStart="6dp" android:text="@string/home_create_action" />
    </LinearLayout>
</LinearLayout>
