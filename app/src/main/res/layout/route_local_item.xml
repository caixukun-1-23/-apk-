<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/bg_cyber_card" android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/route_item_name" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:textColor="@color/textPrimary"
        android:textSize="18sp" android:textStyle="bold" />
    <TextView android:id="@+id/route_item_meta" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/textSecondary" android:textSize="13sp" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_route_item_run"
             android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:layout_marginEnd="4dp"
            android:text="@string/route_item_run" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_route_item_edit"
            style="@style/SaberGhostButton" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="4dp"
            android:text="@string/route_item_edit" />
    </LinearLayout>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginTop="8dp" android:orientation="horizontal">
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_route_item_share"
            style="@style/SaberGhostButton" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:layout_marginEnd="4dp"
            android:text="@string/route_item_export" />
        <com.google.android.material.button.MaterialButton android:id="@+id/btn_route_item_delete"
            style="@style/SaberGhostButton" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:minHeight="48dp" android:layout_marginStart="4dp"
            android:text="@string/route_item_delete" />
    </LinearLayout>
</LinearLayout>
