<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_cyber_card"
    android:orientation="vertical"
    android:padding="14dp">

    <TextView
        android:id="@+id/route_item_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="@color/textPrimary"
        android:textSize="16sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/route_item_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/textSecondary"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_route_item_run"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1.2"
            android:backgroundTint="@color/colorAccent"
            android:minHeight="40dp"
            android:text="@string/route_item_run"
            android:textColor="@color/colorOnPrimary" />

        <Button
            android:id="@+id/btn_route_item_edit"
            style="@style/SaberGhostButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/route_item_edit" />

        <Button
            android:id="@+id/btn_route_item_share"
            style="@style/SaberGhostButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_marginEnd="6dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/route_item_export" />

        <Button
            android:id="@+id/btn_route_item_delete"
            style="@style/SaberGhostButton"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:minHeight="40dp"
            android:text="@string/route_item_delete"
            android:textColor="@color/saberGold" />
    </LinearLayout>
</LinearLayout>
